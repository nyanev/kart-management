# Root .env -- consumed by docker-compose.prod.yml variable interpolation.
# Copy to .env and fill in. Never commit the real file.

# Postgres password for the db service.
DB_PASSWORD=

# Baked into the frontend bundle at build time (a build arg, not a runtime
# value), so changing it requires rebuilding the frontend image.
VITE_API_URL=https://karting.yanev.co/api


# ---------------------------------------------------------------------------
# backend/.env -- a SEPARATE file, mounted via `env_file` on the backend and
# telemetry-worker services. It is not this file. Keys it must contain:
#
#   DEBUG=0
#   SECRET_KEY=
#   ALLOWED_HOSTS=karting.yanev.co
#   DB_NAME=kart_management
#   DB_USER=postgres
#   DB_PASSWORD=            # must match DB_PASSWORD above
#   DB_HOST=db
#   DB_PORT=5432
#   WEATHER_API_KEY=
#
# Telemetry additions (required once the telemetry app is deployed):
#
#   TELEMETRY_BLOB_ROOT=/data/telemetry/blobs
#   TELEMETRY_CACHE_ROOT=/data/telemetry/cache
#   TELEMETRY_REDIS_URL=redis://telemetry-redis:6379/0
#   TELEMETRY_LIBXRK_BACKEND=rust
#   TELEMETRY_DEFAULT_TZ=Europe/Sofia
#   TELEMETRY_MAX_UPLOAD_BYTES=268435456
#   TELEMETRY_JOB_TIMEOUT_SECONDS=600
#   TELEMETRY_ANTHROPIC_API_KEY=     # empty disables AI analysis (returns 503)
#
# TELEMETRY_BLOB_ROOT and TELEMETRY_CACHE_ROOT must match the volume mounts
# in docker-compose.prod.yml. Blobs are the source of truth and must be
# backed up; the cache is disposable and rebuilds from them.
# ---------------------------------------------------------------------------
